#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
    printf 'Usage: agent-run <command> [arguments...]\n' >&2
    exit 64
fi

agent_tmp_root="$HOME/.cache/agent-tmp"
install -d -m 700 "$agent_tmp_root"

# Remove session directories whose agent has exited and released its lock.
# Skip new directories so a session is not removed before flock locks it.
find "$agent_tmp_root" -mindepth 1 -maxdepth 1 -type d -name 'session.*' -mmin +1 \
    -exec flock --nonblock --exclusive {} rm -rf {} \; >/dev/null 2>&1 &

agent_tmpdir=$(mktemp -d "$agent_tmp_root/session.XXXXXXXX")
export TMPDIR="$agent_tmpdir"
# Lets ~/.zshenv give agent shells bash-like globbing and word splitting.
export AGENT_RUN=1
exec flock --shared "$agent_tmpdir" "$@"
